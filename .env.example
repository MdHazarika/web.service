# Canonical site URL used for sitemap and OpenGraph metadata
NEXT_PUBLIC_SITE_URL=https://infomythweb.com

# Required for /api/admin/config. Must be at least 12 characters.
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=change_this_to_a_strong_random_password

# Session security
IRON_SESSION_PASSWORD=your-64-char-random-string

# Turso database (for production on Render)
# Get these from https://turso.tech
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: only needed if you enable Stripe payments (Part 8)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
