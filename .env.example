# Canonical site URL used for sitemap and OpenGraph metadata
NEXT_PUBLIC_SITE_URL=https://infomythweb.com

# Required for /api/admin/config. Must be at least 12 characters.
ADMIN_PASSWORD=change_this_to_a_strong_random_password

# Optional: only needed if you enable Stripe payments (Part 8)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
